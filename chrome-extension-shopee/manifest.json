{
  "manifest_version": 3,
  "name": "Rede Achados BR - Shopee Em Destaque",
  "version": "1.2.0",
  "description": "Pesquisa na Shopee por janela auxiliar minimizada; mostra etapas no Manager sem abrir abas na janela principal.",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://shopee.com.br/*",
    "https://www.shopee.com.br/*",
    "https://redeachados-shopee.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://redeachados-shopee.onrender.com/*"
      ],
      "js": [
        "manager.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://shopee.com.br/*",
        "https://www.shopee.com.br/*"
      ],
      "js": [
        "visible-offers.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
