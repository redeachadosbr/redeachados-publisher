{
  "manifest_version": 3,
  "name": "Rede Achados BR — Ponte ChatGPT para Shopee Manager",
  "version": "1.0.67",
  "description": "Importação automática de imagens com prazo de captura e recuperação da mesma posição; preserva pedidos, SKUs, imagens salvas e recuperação SEO.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "unlimitedStorage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://redeachados-shopee.onrender.com/*",
    "https://chatgpt.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.openai.com/*",
    "https://cf.shopee.com.br/*",
    "https://*.susercontent.com/*",
    "https://*.shopeeusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ponte ChatGPT ↔ Shopee Manager",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://redeachados-shopee.onrender.com/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "120"
}
